+/** IPv4 routes always name a gateway; OpenVPN otherwise defaults to the VPN. */
+function renderRoute(route: AzureVpnRoute, gateway: 'vpn_gateway' | 'net_gateway'): string {
+  const prefix = validatePrefix(`${route.address}/${route.prefixLength}`, 'route');
+  if (prefix.family !== 4 || route.family !== 4) {
+    throw new OpenP2SError('IPv6 client routes are not supported');
+  }
+  const mask = Array.from({ length: 4 }, (_, index) => {
+    const bits = Math.min(8, Math.max(0, prefix.prefixLength - index * 8));
+    return 256 - 2 ** (8 - bits);
+  });
+  // A destination containing host bits still denotes the requested network.
+  const network = prefix.address.split('.').map((octet, index) => Number(octet) & mask[index]!);
+  return `route ${network.join('.')} ${mask.join('.')} ${gateway}`;
+}
