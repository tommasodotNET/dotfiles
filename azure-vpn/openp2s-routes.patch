diff --git a/tests/profile-routes.test.ts b/tests/profile-routes.test.ts
new file mode 100644
index 0000000..f8bfe2e
--- /dev/null
+++ b/tests/profile-routes.test.ts
@@ -0,0 +1,176 @@
+/** Synthetic route policy regressions: no VPN, authentication or host changes. */
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, it } from 'node:test';
+import { ProfileError } from '../src/errors.ts';
+import { renderOpenVpnConfig } from '../src/openvpn/config.ts';
+import { AzureProfileParser } from '../src/profile/parser.ts';
+import type { AzureVpnProfile } from '../src/profile/types.ts';
+
+const minimal = readFileSync(join(import.meta.dirname, 'fixtures/valid-minimal.xml'), 'utf8');
+function parse(routes = ''): AzureVpnProfile {
+  return new AzureProfileParser().parse(
+    minimal.replace('</AzVpnProfile>', `<clientconfig>${routes}</clientconfig></AzVpnProfile>`),
+  );
+}
+function render(profile: AzureVpnProfile, probe = false): string[] {
+  return renderOpenVpnConfig({
+    profile,
+    probe,
+    caPath: '/synthetic/ca.pem',
+    credentials: { kind: 'external' },
+  }).split('\n');
+}
+const routes = `
+  <includeroutes>
+    <route><destination>0.0.0.0</destination><mask>0</mask></route>
+    <route><destination>128.0.0.0</destination><mask>1</mask></route>
+    <route><destination>10.20.0.0</destination><mask>255.255.0.0</mask></route>
+    <includeroute>10.30.0.0/24</includeroute>
+    <includeroute>192.0.2.7</includeroute>
+  </includeroutes>
+  <excluderoutes>
+    <route><destination>192.168.0.0</destination><mask>16</mask></route>
+    <route><destination>192.168.0.0</destination><mask>255.255.0.0</mask></route>
+    <route><address>198.51.100.0</address><prefixlength>31</prefixlength></route>
+    <route>203.0.113.9/32</route>
+    <excluderoute>192.0.2.0/25</excluderoute>
+  </excluderoutes>`;
+const expected = [
+  'route remote_host 255.255.255.255 net_gateway',
+  'route 0.0.0.0 0.0.0.0 vpn_gateway',
+  'route 128.0.0.0 128.0.0.0 vpn_gateway',
+  'route 10.20.0.0 255.255.0.0 vpn_gateway',
+  'route 10.30.0.0 255.255.255.0 vpn_gateway',
+  'route 192.0.2.7 255.255.255.255 vpn_gateway',
+  'route 192.168.0.0 255.255.0.0 net_gateway',
+  'route 198.51.100.0 255.255.255.254 net_gateway',
+  'route 203.0.113.9 255.255.255.255 net_gateway',
+  'route 192.0.2.0 255.255.255.128 net_gateway',
+];
+
+describe('profile include/exclude route policy', () => {
+  it('parses and deduplicates exclusions in the same shapes as inclusions', () => {
+    const profile = parse(routes);
+    assert.deepEqual(
+      profile.excludeRoutes?.map((route) => route.cidr),
+      ['192.168.0.0/16', '198.51.100.0/31', '203.0.113.9/32', '192.0.2.0/25'],
+    );
+    assert.equal(profile.excludeRoutes?.[0]?.family, 4);
+    assert.equal(profile.excludeRoutes?.[0]?.prefixLength, 16);
+  });
+
+  it('emits every include/exclude with explicit netmask and correct gateway', () => {
+    assert.deepEqual(
+      render(parse(routes)).filter((line) => line.startsWith('route ')),
+      expected,
+    );
+  });
+
+  it('keeps route-noexec for profile routes as well as pushed routes during probes', () => {
+    const lines = render(parse(routes), true);
+    assert.deepEqual(
+      lines.filter((line) => line.startsWith('route ')),
+      expected,
+    );
+    for (const directive of ['dev null', 'route-noexec', 'ifconfig-noexec']) {
+      assert.ok(lines.includes(directive));
+    }
+    assert.ok(!lines.includes('dev tun'));
+  });
+
+  it('keeps normal PUSH_REPLY route handling', () => {
+    const lines = render(parse(routes));
+    assert.ok(lines.includes('client'));
+    for (const forbidden of ['route-nopull', 'pull-filter', 'route-noexec', 'ifconfig-noexec']) {
+      assert.ok(!lines.some((line) => line.startsWith(forbidden)));
+    }
+  });
+
+  it('accepts omitted, empty and Azure nil route collections', () => {
+    for (const xml of [
+      '',
+      '<includeroutes/><excluderoutes/>',
+      '<excluderoutes xmlns:i="http://www.w3.org/2001/XMLSchema-instance" i:nil="true"/>',
+    ]) {
+      assert.deepEqual(parse(xml).excludeRoutes, []);
+      assert.deepEqual(
+        render(parse(xml)).filter((line) => line.startsWith('route ')),
+        ['route remote_host 255.255.255.255 net_gateway'],
+      );
+    }
+    const { excludeRoutes: _excluded, ...legacy } = parse();
+    assert.deepEqual(
+      render(legacy).filter((line) => line.startsWith('route ')),
+      ['route remote_host 255.255.255.255 net_gateway'],
+    );
+  });
+
+  it('supports namespace-prefixed exclusions', () => {
+    const profile = parse(
+      '<az:excluderoutes xmlns:az="urn:test"><az:route><az:destination>192.0.2.0</az:destination><az:mask>24</az:mask></az:route></az:excluderoutes>',
+    );
+    assert.equal(profile.excludeRoutes?.[0]?.cidr, '192.0.2.0/24');
+  });
+
+  it('normalises host bits before giving OpenVPN a network and mask', () => {
+    assert.ok(
+      render(
+        parse('<excluderoutes><excluderoute>192.0.2.123/24</excluderoute></excluderoutes>'),
+      ).includes('route 192.0.2.0 255.255.255.0 net_gateway'),
+    );
+  });
+
+  for (const kind of ['include', 'exclude']) {
+    for (const bad of [
+      `<${kind}route>10.0.0.999/24</${kind}route>`,
+      `<${kind}route>10.0.0.0/33</${kind}route>`,
+      `<${kind}route>10.0.0.0/-1</${kind}route>`,
+      `<${kind}route>10.0.0.0/24\nscript-security 2</${kind}route>`,
+      `<${kind}route>2001:db8::/32</${kind}route>`,
+      `<${kind}route/>`,
+      '<route/>',
+      '<route><mask>24</mask></route>',
+      '<route><destination>10.0.0.0</destination><mask>255.0.255.0</mask></route>',
+      '<route><destination>10.0.0.0</destination><mask/></route>',
+      '<unexpected>10.0.0.0/24</unexpected>',
+      '10.0.0.0/24',
+    ]) {
+      it(`rejects invalid or unsupported ${kind} input: ${JSON.stringify(bad)}`, () => {
+        assert.throws(() => parse(`<${kind}routes>${bad}</${kind}routes>`), ProfileError);
+      });
+    }
+    it(`rejects repeated ${kind} containers rather than ignoring later routes`, () => {
+      const xml = `<${kind}routes><${kind}route>10.0.0.0/8</${kind}route></${kind}routes>`;
+      assert.throws(() => parse(xml + xml), ProfileError);
+    });
+  }
+
+  it('fails closed on IPv6 exclusions even for programmatically constructed profiles and probes', () => {
+    const profile = {
+      ...parse(),
+      excludeRoutes: [
+        { address: '2001:db8::', prefixLength: 32, family: 6 as const, cidr: '2001:db8::/32' },
+      ],
+    };
+    for (const probe of [false, true]) {
+      assert.throws(() => render(profile, probe), /IPv6 client routes are not supported/);
+    }
+  });
+
+  it('rejects injected addresses even for a programmatically constructed profile', () => {
+    const profile = {
+      ...parse(),
+      excludeRoutes: [
+        {
+          address: '192.0.2.0\nscript-security 2',
+          prefixLength: 24,
+          family: 4 as const,
+          cidr: 'unused',
+        },
+      ],
+    };
+    assert.throws(() => render(profile), ProfileError);
+  });
+});
